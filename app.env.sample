# app.env.sample
# Copy to app.env and adjust values before starting the stack.
# These variables override the matching values in default.env for this app.
# No `export` prefix - this file is read by `docker compose --env-file`.

TZ=America/New_York
BASE_DOMAIN_NAME=example.com
BASE_HOST_NAME=taiga.example.com

# Django secret key; generated and kept in ./volumes/config/taiga when empty
APP_SECRET_TOKEN_64=replace-with-a-random-64-character-hex-string

# First administrator, created on first start
APP_ADMIN_USER=admin
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASS=replace-with-a-random-password

# RabbitMQ password shared by the app and rabbitmq services
APP_RABBITMQ_PASS=replace-with-a-random-password

DB_USER_NAME=taiga
DB_USER_PASS=replace-with-a-random-password
DB_CREATE_DATABASE_NAME=taiga
